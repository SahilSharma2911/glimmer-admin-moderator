# Base URL of the Glimmers backend API, including the version prefix.
# Bump the version here (e.g. /api/v2) — request paths in code are version-agnostic.
# Dev:  http://localhost:3000/api/v1   (the backend's default PORT)
# Prod: https://app.glimmersapp.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
